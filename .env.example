# Copy to .env and fill in. Never commit .env — it is in .gitignore and .dockerignore.

# Main database (Postgres; e.g. Supabase transaction pooler, port 6543)
MAIN_DB_URL=
# Session-mode URL for nightly pg_dump (transaction pooler drops SET statements)
MAIN_DB_DUMP_URL=
# Optional read replica used by the dashboard / mirror
REPLICA_DB_URL=

# Archive database for rejected contacts (the archive-db container)
POSTGRES_PASSWORD=
ARCHIVE_DB_URL=

# Telegram bot (human-in-the-loop review): token from @BotFather, your numeric user id
TELEGRAM_TOKEN=
TELEGRAM_OWNER_ID=

# Google Sheets export: service-account key path and the Apps Script web-app secret
GOOGLE_SA_JSON=
SHEETS_WEBAPP_SECRET=

# LLM grader: Claude Code token (`claude setup-token`)
CLAUDE_CODE_OAUTH_TOKEN=

# VPN subscription used to build per-account exits (optional)
VPN_SUB_URL=
VPN_SUB_HWID=
VPN_DIRECT_IF=

# Paths (defaults are fine for local runs)
LEADGEN_GRIDS_DIR=
LEADGEN_BACKUP_DIR=
LEADGEN_CONTACTS_CSV=
LEADGEN_WALKED_LEDGER=
